# 统一换行符：防止 Windows 下的 CRLF 被带进 Linux 脚本导致
# "/bin/bash^M: bad interpreter: No such file or directory"
* text=auto eol=lf

# 明确指定必须用 LF 的文件类型
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.cnf   text eol=lf
*.repo  text eol=lf
*.md    text eol=lf

# Windows 批处理必须用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.gz    binary
*.zip   binary
*.tar   binary
